# Browser-visible API base. Leave empty to use same-origin requests (Vite dev
# proxies /api to BACKEND_PROXY_TARGET; nginx proxies it in production).
VITE_API_BASE_URL=

# Browser-visible WebSocket base. In local dev, point directly at the FastAPI backend.
VITE_WS_BASE_URL=ws://localhost:8000

# Dev-server proxy target for /api, /sdk.js, /widget-demo, /basjoo-logo.png, /health.
# Read by vite.config.ts at dev-server start only; unused by the production build.
BACKEND_PROXY_TARGET=http://localhost:8000
